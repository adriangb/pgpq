/*

!/.gitignore
!/core
!/py
!/json
!/Cargo.toml
!/Cargo.lock
!/pyproject.toml
!/uv.lock
!/.pre-commit-config.yaml
!/ruff.toml
!/Makefile
!/README.md
!/DEVELOPMENT.md
# This file is an allowlist (`/*` above ignores everything at the root), so a
# new top-level directory is invisible to git until it is un-ignored here.
!/scripts
!/.github
!/LICENSE.txt
!/.gitattributes

__pycache__
*.so
*.pyd
.venv
.DS_Store

_pgpq.pyd
